{
  "name": "yixi-gentle-moments",
  "version": "0.2.6",
  "private": true,
  "description": "一息 · 温柔瞬间铺 — 情绪流通经营游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && BASE_PATH=/Web006/ vite build && node scripts/rewrite-asset-base.mjs /Web006/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite-node scripts/run-core-smoke.ts",
    "check": "npm test && npm run build && npm run smoke",
    "perf": "vite-node scripts/perf-baseline.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
